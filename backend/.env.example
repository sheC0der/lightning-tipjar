NODE_ENV=development
PORT=3000

# PostgreSQL connection string (e.g. from a Railway Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/database

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Blink Lightning API (https://dev.blink.sv)
BLINK_API_URL=https://api.blink.sv/graphql
BLINK_API_KEY=your_blink_api_key_here
BLINK_WEBHOOK_SECRET=

# Flutterwave v4 (https://developer.flutterwave.com) - OAuth2 client-credentials.
# Sandbox base URL shown; switch to your production base URL when going live.
FLUTTERWAVE_API_URL=https://developersandbox-api.flutterwave.com
FLUTTERWAVE_TOKEN_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
FLUTTERWAVE_CLIENT_ID=your_flutterwave_client_id_here
FLUTTERWAVE_CLIENT_SECRET=your_flutterwave_client_secret_here
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key_here
FLUTTERWAVE_SENDER_EMAIL=payouts@lightningtipjar.app

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
